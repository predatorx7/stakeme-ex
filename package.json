{
	"name": "@stakeme/monorepo",
	"description": "StakeMe Exchange (SMX) monorepo",
	"version": "0.1.0",
	"private": true,
	"workspaces": [
		"packages/client",
		"packages/contracts",
		"packages/app"
	],
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	},
	"repository": {
		"url": "https://github.com/predatorx7/stakeme-ex",
		"type": "git"
	},
	"scripts": {
		"lint": "eslint --ext .js,.ts,.jsx,.tsx",
		"lint:fix": "npm run lint -- --fix",
		"test": "npm test --workspaces --if-present",
		"check": "npm run check --workspaces --if-present",
		"build": "npm run build --workspaces --if-present",
		"migrate": "npm run -w @stakeme/app migrate",
		"migrate:plan": "npm run -w @stakeme/app migrate:plan",
		"seed:demo": "node --env-file-if-exists=.env --env-file-if-exists=.env.local packages/app/scripts/seed-demo.ts",
		"dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local packages/app/scripts/dev.ts",
		"start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local packages/app/scripts/start.ts",
		"pgtyped:typegen": "sh scripts/pgtyped.sh",
		"gen": "npm run pgtyped:typegen && npm run openapi:gen --workspace=packages/app",
		"gen:check": "npm run gen:check --workspace=packages/app",
		"db:up": "docker compose -f dev/docker-compose.yaml up -d --wait",
		"db:down": "docker compose -f dev/docker-compose.yaml down"
	},
	"devDependencies": {
		"@adiwajshing/eslint-config": "github:adiwajshing/eslint-config#607fc28f986c645194c69047292883ae0d1aec02",
		"@electric-sql/pglite": "^0.5.15",
		"@eslint/css": "^2.0.1",
		"@pgtyped/cli": "^2.4.3",
		"@types/node": "^24.19.2",
		"eslint": "^10.14.0",
		"openapi-typescript": "^7.13.0",
		"typescript": "^5.9.3"
	}
}
