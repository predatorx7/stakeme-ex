{
	"name": "@stakeme/client",
	"title": "StakeMe Client",
	"version": "0.1.0",
	"description": "Typed HTTP client for the StakeMe Exchange (SMX) API, generated from packages/app/openapi.yaml.",
	"type": "module",
	"sideEffects": false,
	"main": "./lib/index.js",
	"types": "./lib/index.d.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./lib/index.js"
		},
		"./api": {
			"types": "./src/api.ts",
			"import": "./lib/api.js"
		},
		"./openapi": {
			"types": "./src/types/index.ts",
			"import": "./lib/types/index.js"
		}
	},
	"files": [
		"lib",
		"src"
	],
	"engines": {
		"node": ">=24.0.0"
	},
	"repository": {
		"url": "https://github.com/predatorx7/stakeme-ex",
		"type": "git"
	},
	"scripts": {
		"build": "tsc",
		"check": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "^5.9.0"
	}
}
