{
	"name": "@stakeme/contracts",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "StakeMe Exchange smart contracts (Hardhat 3 + viem)",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"build": "hardhat compile && npm run abis",
		"abis": "node scripts/export-abis.ts",
		"test": "hardhat test",
		"node": "hardhat node",
		"deploy:local": "hardhat ignition deploy ignition/modules/Deploy.ts",
		"deploy:hedera": "hardhat ignition deploy ignition/modules/Deploy.ts --network hederaTestnet",
		"deploy:sepolia": "hardhat ignition deploy ignition/modules/Deploy.ts --network sepolia",
		"deploy:0g": "hardhat ignition deploy ignition/modules/Deploy.ts --network ogGalileo"
	},
	"devDependencies": {
		"@nomicfoundation/hardhat-ignition": "^3.1.9",
		"@nomicfoundation/hardhat-ignition-viem": "^3.1.6",
		"@nomicfoundation/hardhat-keystore": "^3.1.2",
		"@nomicfoundation/hardhat-network-helpers": "^3.0.12",
		"@nomicfoundation/hardhat-node-test-runner": "^3.1.2",
		"@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
		"@nomicfoundation/hardhat-verify": "^3.1.4",
		"@nomicfoundation/hardhat-viem": "^3.1.0",
		"@nomicfoundation/hardhat-viem-assertions": "^3.1.5",
		"@nomicfoundation/ignition-core": "^3.1.11",
		"@types/node": "^26.6.6",
		"hardhat": "^3.21.2",
		"typescript": "^7.0.2",
		"viem": "^2.57.16"
	},
	"dependencies": {
		"@openzeppelin/contracts": "^5.6.1"
	}
}
