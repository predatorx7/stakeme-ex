# Test-only, non-secret deterministic values, loaded via --env-file in the
# `test` script. NOT for production.

# App source only branches on production/development; this keeps tests on the
# non-prod path (for example, non-secure cookies).
NODE_ENV=test
CANONICAL_ORIGIN=http://localhost:4020
BETTER_AUTH_SECRET=test-better-auth-secret-not-for-production-000000
DEMO_MODE=1
