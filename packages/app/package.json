{
	"name": "@stakeme/app",
	"version": "0.1.0",
	"description": "StakeMe Exchange (SMX) app server and exchange UI",
	"type": "module",
	"private": true,
	"exports": {
		".": {
			"import": "./src/index.ts",
			"types": "./src/index.ts"
		}
	},
	"files": [
		"lib",
		"src",
		"public"
	],
	"repository": {
		"url": "https://github.com/predatorx7/stakeme-ex",
		"type": "git"
	},
	"scripts": {
		"build": "tsc && vite build --config vite.client.config.ts",
		"openapi:typegen": "node ./scripts/openapi-typegen.ts",
		"openapi:routesgen": "node ./scripts/routes-gen.ts",
		"openapi:gen": "npm run openapi:typegen && npm run openapi:routesgen",
		"gen:check": "node ./scripts/check-gen.ts",
		"pretest": "node --env-file=.test.env ./scripts/warm-test-snapshot.ts",
		"test:files": "node --env-file=.test.env --test-timeout=120000",
		"test": "npm run test:files -- --test tests/*.test.ts",
		"check": "tsc -p tsconfig.test.json && npm run xss-scan",
		"xss-scan": "xss-scan",
		"migrate": "./scripts/migrate.ts",
		"migrate:plan": "npm exec pgm plan --workspace=@stakeme/app -- --plugin smx"
	},
	"dependencies": {
		"@0gfoundation/0g-compute-ts-sdk": "^0.9.0",
		"@0gfoundation/0g-storage-ts-sdk": "^1.2.13",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@haathie/pgmb": "^0.2.26",
		"@hapi/boom": "^9.1.4",
		"@hashgraph/hedera-wallet-connect": "^2.1.3",
		"@hiero-ledger/sdk": "^2.90.1",
		"@kitajs/html": "^4.2.13",
		"@messcat/pg-migrate": "^0.1.3",
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/exporter-prometheus": "^0.301.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.301.0",
		"@opentelemetry/instrumentation-express": "^0.73.0",
		"@opentelemetry/instrumentation-http": "^0.301.0",
		"@opentelemetry/instrumentation-pg": "^0.78.0",
		"@opentelemetry/instrumentation-runtime-node": "^0.38.0",
		"@opentelemetry/sdk-metrics": "^3.1.0",
		"@opentelemetry/sdk-node": "^0.301.0",
		"@pgtyped/runtime": "^2.4.2",
		"@reclaimprotocol/client": "^0.1.43",
		"@reclaimprotocol/design": "github:reclaimprotocol/reclaim-design#60641e29c1b17eb2724be523ac4614b55b260687",
		"@reown/appkit-universal-connector": "^1.8.24",
		"@stakeme/client": "*",
		"@stakeme/contracts": "^0.1.0",
		"@worldcoin/idkit-core": "^4.6.0",
		"@x402/core": "^2.30.0",
		"@x402/hedera": "^2.30.0",
		"better-auth": "^1.7.18",
		"ethers": "^6.13.1",
		"express": "^5.3.0",
		"express-openapi-validator": "^5.6.2",
		"htmx-ext-response-targets": "^2.0.4",
		"htmx-ext-sse": "^2.2.4",
		"htmx.org": "^2.0.11",
		"kysely": "^0.29.8",
		"multer": "^2.5.0",
		"pg": "^8.23.1",
		"pino": "^9.14.0",
		"pino-http": "^10.5.0",
		"qrcode": "^1.5.4",
		"qs": "^6.17.1",
		"viem": "^2.57.16",
		"yaml": "^2.9.1"
	},
	"devDependencies": {
		"@kitajs/ts-html-plugin": "^4.1.4",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.3.0",
		"@types/pg": "^8.23.1",
		"@types/qrcode": "^1.5.6",
		"@types/qs": "^6.15.1",
		"happy-dom": "^21.0.4",
		"kysely-pglite": "^0.6.1",
		"typed-htmx": "^0.3.1",
		"vite": "^8.3.6"
	}
}
