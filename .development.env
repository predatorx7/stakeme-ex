## Copy this file to .env (or .env.local) before running `npm run dev`.

NODE_ENV=development
# Local Docker Postgres (see dev/docker-compose.yaml) on host port 5442.
DB_URI=postgresql://postgres@localhost:5442/postgres
CANONICAL_ORIGIN=http://localhost:4020
PORT=4020
# Dev-only secret for Better Auth session signing. Do not reuse.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-do-not-use-in-prod-0123456789
# Demo mode: simulated chain, fixture proofs, demo-only routes.
DEMO_MODE=1

# ─── Optional tuning (defaults shown) ───
# LOG_LEVEL=info
# MAX_DB_CONNS=10

# ─── World ID ───
# WORLD_ID_APP_ID=
# WORLD_ID_ACTION=

# ─── Reclaim Protocol ───
# RECLAIM_APP_ID=
# RECLAIM_APP_SECRET=
# RECLAIM_PROVIDER_ID=

# ─── Chain (simulated chain mode when CHAIN_RPC_URL is unset) ───
# CHAIN_RPC_URL=
# CHAIN_ID=
# ORACLE_PRIVATE_KEY=
# USDC_ADDRESS=
# FACTORY_ADDRESS=

# ─── 0G Compute (AI audit) ───
# OG_COMPUTE_RPC_URL=
# OG_COMPUTE_PRIVATE_KEY=
# OG_COMPUTE_PROVIDER=

# ─── Arkiv ───
# ARKIV_RPC_URL=
# ARKIV_PRIVATE_KEY=
