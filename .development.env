## Copy this file to .env (or .env.local) before running `npm run dev`.

NODE_ENV=development
# Local Docker Postgres (see dev/docker-compose.yaml) on host port 5442.
DB_URI=postgresql://postgres@localhost:5442/postgres
CANONICAL_ORIGIN=http://localhost:4020
PORT=4020
# Dev-only secret for Better Auth session signing. Do not reuse.
BETTER_AUTH_SECRET=dev-only-better-auth-secret-do-not-use-in-prod-0123456789
# Demo mode: simulated chain, fixture proofs, demo-only routes.
DEMO_MODE=1

# ─── Optional tuning (defaults shown) ───
# LOG_LEVEL=info
# MAX_DB_CONNS=10

# ─── Integrations: each falls back to a demo path when unset ───
# See docs/integrations/*.md. Secrets stay server-side.

# WalletConnect project id. PUBLIC value, safe in the browser. Create a project
# at https://dashboard.walletconnect.com and add your origin (for example
# http://localhost:4020) to its allowlist. Unset: the WalletConnect option is
# hidden; sign-in offers a browser extension, a generated key, or an imported
# key, and Hedera dividends use a generated or imported key.
# WALLETCONNECT_PROJECT_ID=

# World ID 4.0 (Developer Portal). Unset: Simulate success / Sybil buttons.
# WORLD_APP_ID=
# WORLD_RP_ID=
# WORLD_RP_SIGNING_KEY=
# WORLD_ACTION=smx-launch-ipo
# WORLD_ENV=staging

# Reclaim Protocol (@reclaimprotocol/client). Unset: demo fixture proofs
# (needs DEMO_MODE=1). Never commit the org secret.
# RECLAIM_ORG_SECRET=
# RECLAIM_PROVIDER_ID=
# Only if the org has result encryption on:
# RECLAIM_ORG_ETH_PRIVATE_KEY=
# Chain: Hedera EVM testnet via Hashio (chain 296 when CHAIN_ID is unset).
# Simulated chain mode when CHAIN_RPC_URL is unset.
# CHAIN_RPC_URL=
# CHAIN_ID=
# ORACLE_PRIVATE_KEY=
# CHAIN_NULLIFIER_SALT=
# FACTORY_ADDRESS=

# Storage adapter: 0g (default, local fallback without keys) or local.
# STORAGE_PROVIDER=0g
# 0G Compute + Storage. Unset: rules-engine audit and local:<sha256> log ref.
# ZG_PRIVATE_KEY=
# ZG_RPC_URL=https://evmrpc-testnet.0g.ai
# ZG_INDEXER_URL=https://indexer-storage-testnet-turbo.0g.ai
# ZG_PROVIDER_ADDRESS=
# ZG_LEDGER_DEPOSIT=3

# Hedera HTS dividend rail. Unset: simulated receipts.
# HEDERA_OPERATOR_ID=
# HEDERA_OPERATOR_KEY=
# HEDERA_DIVIDEND_TOKEN_ID=
# HEDERA_NETWORK=testnet

# 0G Router (audit verdict via prepaid credits; unset = Compute/rules engine)
# ZG_ROUTER_API_KEY=sk-...
# ZG_ROUTER_MODEL=glm-5.2
# ZG_ROUTER_TRUST_MODE=
# ZG_ROUTER_BASE_URL=https://router-api.0g.ai/v1

# Admin key for demo-only routes (POST /api/trigger-default, header
# X-Admin-Key). Unset disables them. Generate: openssl rand -hex 32
# SMX_ADMIN_KEY=
